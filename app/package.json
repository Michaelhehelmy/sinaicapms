  "version": "1.1.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "gen:types": "openapi-typescript ../backend/openapi.json -o src/lib/api-types.ts",
