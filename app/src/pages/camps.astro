---
// Marketplace camps listing page (/camps). Renders the same search + grid as
// the marketplace home (CampsSection) under its own URL. Marketplace-only:
// forbidden on tenant zones (see lib/routeZones.ts).
import PublicLayout from '@/layouts/PublicLayout.astro';
import ZoneGuard from '@/components/public/ZoneGuard.astro';
import CampsSection from '@/components/public/CampsSection.astro';
import { normalizeAssetUrl } from '@/lib/utils';

const forbidden = Astro.locals.routeForbidden;
if (forbidden) Astro.response.status = 404;

const API_BASE = Astro.locals.API_BASE as string;
const ssrFetch = Astro.locals.API_FETCH as (path: string, init?: RequestInit) => Promise<Response>;

let tenants: Record<string, unknown>[] = [];
let marketplaceBranding: Record<string, unknown> | null = null;
let tenantsLoaded = false;

try {
  const res = await ssrFetch('/tenants/public');
  if (res.ok) {
    tenantsLoaded = true;
    const all: Record<string, unknown>[] = (await res.json()) as Record<string, unknown>[];
    const allCamel = all;
    marketplaceBranding = allCamel.find((t) => t.id === 'marketplace') || null;
    tenants = allCamel.filter((t) => t.id !== 'marketplace');
  }
} catch (e) {
  console.error('Error fetching public tenants:', e);
}

const primaryColor = (marketplaceBranding?.primaryColor as string) || '#2c3e50';
const marketplaceName = (marketplaceBranding?.name as string) || 'Sinai Camps';
const pageTitle = `Camps — ${marketplaceName}`;
const pageDesc = 'Browse all registered adventure camps on Sinai Camps. Search by name, location, capacity, and activities.';

// Strips any </script> sequences from strings that will be embedded in
// ld+json so tenant-controlled data can never break out of the JSON script.
function sanitizeForJsonLd(obj: Record<string, unknown>): Record<string, unknown> {
  const clean: Record<string, unknown> = {};
  for (const [k, v] of Object.entries(obj)) {
    if (typeof v === 'string') {
      clean[k] = v.replace(/<\/script/gi, '');
    } else if (v && typeof v === 'object') {
      clean[k] = sanitizeForJsonLd(v as Record<string, unknown>);
    } else {
      clean[k] = v;
    }
  }
  return clean;
}

const jsonLd = sanitizeForJsonLd({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDesc,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: tenants.length,
    itemListElement: tenants.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.name || `Camp ${i + 1}`,
      url: new URL(`/camp/${t.id}`, Astro.url).href,
      image: normalizeAssetUrl(t.logoUrl as string) || undefined,
    })),
  },
});
---
{
  forbidden ? (
    <ZoneGuard />
  ) : (
    <PublicLayout
      title={pageTitle}
      tenant={marketplaceBranding}
      tenantName={marketplaceName}
      primaryColor={primaryColor}
      description={pageDesc}
      activePage="camps"
    >
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
      <!-- Hero -->
      <section
        data-testid="hero-banner"
        class="relative overflow-hidden py-16 md:py-20"
        style={`background: linear-gradient(135deg, ${primaryColor}0D 0%, ${primaryColor}1E 100%)`}
      >
        <div class="mx-auto max-w-4xl px-6 text-center">
          <h1 data-testid="hero-title" class="text-3xl font-extrabold tracking-tight text-[var(--text)] sm:text-4xl md:text-5xl">
            Explore All Camps
          </h1>
          <p data-testid="hero-description" class="mx-auto mt-3 mb-8 max-w-2xl text-lg text-[var(--text-muted)] md:text-xl">
            Browse every registered camp, filter by location, capacity, and activities, then book directly with the camp.
          </p>
          <a href="#camps" data-testid="browse-camps-link" class="btn btn-primary">Browse Camps</a>
        </div>
      </section>

      <CampsSection tenants={tenants} apiBase={API_BASE} ssrRendered={tenantsLoaded} />
    </PublicLayout>
  )
}
