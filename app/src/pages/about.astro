---
import PublicLayout from '@/layouts/PublicLayout.astro';
import { getTenantSSRData } from '@/middleware/tenant';
import { escHtml, normalizeAssetUrl, readableTextOn } from '@/lib/utils';

function escapeUrl(url: string | undefined | null): string {
  if (!url) return '';
  return url.replace(/['")\)]/g, '');
}

const { tenant: rawTenant, primaryColor, tenantName } = await getTenantSSRData(Astro.url, Astro.locals.API_FETCH);
const tenant = rawTenant as (typeof rawTenant & Record<string, unknown>) | null;
const missionText = (tenant as Record<string, unknown>)?.missionText as string | undefined;
const featuresRaw = (tenant as Record<string, unknown>)?.features as string | { title: string; description: string }[] | undefined;

const tenantParam = Astro.url.searchParams.get('tenant');
const querySuffix = tenantParam ? `?tenant=${tenantParam}` : '';
const accommodationsUrl = Astro.locals.zone === 'tenant' ? `/rooms${querySuffix}` : `/camps${querySuffix}`;

const heroImage = normalizeAssetUrl(
  tenant?.heroImageUrl as string,
  'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?q=80&w=1200&auto=format&fit=crop',
);
---
<PublicLayout
  title="About Us"
  tenant={tenant}
  tenantName={tenantName}
  primaryColor={primaryColor}
  activePage="about"
>
  <!-- Hero -->
  <section
    data-testid="hero-banner"
    class="relative flex min-h-[60vh] items-end overflow-hidden px-6 pb-16 pt-24 text-center text-white"
    style={`background: linear-gradient(180deg, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.5) 55%, rgba(0,0,0,0.8) 100%), url(${escapeUrl(heroImage)}) center/cover;`}
  >
    <!-- Topographic texture overlay -->
    <div class="bg-topo pointer-events-none absolute inset-0 text-white opacity-20" aria-hidden="true"></div>
    <div class="relative z-10 mx-auto w-full max-w-5xl">
      <p class="mb-3 flex items-center justify-center gap-2 text-xs font-bold uppercase tracking-[0.25em] text-white/80">
        <span class="inline-block h-px w-8 bg-white/60" aria-hidden="true"></span>
        Our Story
        <span class="inline-block h-px w-8 bg-white/60" aria-hidden="true"></span>
      </p>
      <h1 data-testid="hero-title" class="font-display mb-3 text-4xl font-black tracking-tight md:text-5xl">About {escHtml(tenantName)}</h1>
      <p data-testid="hero-description" class="text-lg opacity-90">Learn more about our mission, camp history, and wilderness roots.</p>
      <div class="mt-7">
        <a
          href={accommodationsUrl}
          class="inline-block rounded-full px-6 py-3 text-center font-bold shadow-md transition hover:-translate-y-0.5 hover:shadow-lg"
          style={`background: linear-gradient(135deg, ${primaryColor}, ${primaryColor}d9); color: ${readableTextOn(primaryColor)}; box-shadow: 0 10px 24px -8px ${primaryColor}59;`}
        >
          Explore Accommodations
        </a>
      </div>
    </div>
  </section>

  <!-- Content -->
  <section class="mx-auto max-w-4xl px-6 py-20">
    <div class="grid gap-12 md:grid-cols-[3fr_2fr]">
      <!-- Story & Mission -->
      <div>
        <p class="mb-3 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-[var(--primary)]">
          <span class="inline-block h-0.5 w-4 rounded-full bg-[var(--primary)]" aria-hidden="true"></span>
          About
        </p>
        <h2 class="section-heading mb-5">Our Story & Heritage</h2>
        <p class="mb-5 leading-relaxed text-[var(--text-muted)]">
          {escHtml(
            tenant?.aboutText ||
            'Welcome to our camp! We have been hosting outdoor enthusiasts, families, and campers for over 15 years. We focus on outdoor exploration, survival skills, wilderness lodging, and fostering a deep respect for the natural environment.'
          )}
        </p>
        {missionText && (
          <>
            <h3 class="mb-3 mt-8 font-bold">Our Core Mission</h3>
            <p class="leading-relaxed text-[var(--text-muted)]">
              {escHtml(missionText)}
            </p>
          </>
        )}
      </div>

      {/* Feature Cards — dynamic from tenant data */}
      {featuresRaw && (() => {
        let features: { title: string; description: string }[] = [];
        try { features = typeof featuresRaw === 'string' ? JSON.parse(featuresRaw) : featuresRaw; } catch { /* ignore */ }
        if (!Array.isArray(features) || features.length === 0) return null;
        return (
          <div class="flex flex-col gap-5">
            {features.map((f) => (
              <div class="rounded-xl border border-warm-100 bg-white p-6 shadow-card transition-shadow hover:shadow-elevated">
                <h4 class="mb-2 text-lg font-extrabold">{escHtml(f.title)}</h4>
                <p class="text-sm text-[var(--text-muted)]">{escHtml(f.description)}</p>
              </div>
            ))}
          </div>
        );
      })()}
    </div>
  </section>
</PublicLayout>
