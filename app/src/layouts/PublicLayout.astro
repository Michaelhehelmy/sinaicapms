---
import { normalizeAssetUrl } from '@/lib/utils';
import '@/styles/global.css';
import { buildTenantTheme, type TenantTheme } from '@/lib/theme';
import { resolveDataDomain } from '@/lib/plausible';

const {
  title = 'Home',
  tenant = {},
  tenantName = 'CampMaster Pro',
  primaryColor,
  theme: themeProp,
  activePage = '',
  description,
  lang: propLang,
  dir: propDir,
} = Astro.props;

// Determine language from (in priority order): prop > query param > cookie > default 'en'
const queryLang = Astro.url.searchParams.get('lang');
const cookieLang = Astro.cookies.get('sc_lang')?.value;
const lang = propLang || queryLang || cookieLang || 'en';
const dir = propDir || (lang === 'ar' ? 'rtl' : 'ltr');

const faviconUrl = normalizeAssetUrl(tenant?.faviconUrl) || normalizeAssetUrl(tenant?.logoUrl) || '/favicon.ico';
const brandColor = primaryColor || '#4a7c4f';

// Per-tenant theme: prefer the prebuilt theme passed from SSR data; older
// callers that only pass `primaryColor` are covered by the fallback builder.
const resolvedTheme: TenantTheme = themeProp || buildTenantTheme({ primaryColor: brandColor });
// `define:vars` turns plain keys into `--<key>` CSS custom properties, so the
// already-prefixed `--brand-*` keys map 1:1 onto the emitted style attribute.
const themeVars = {
  'brand-primary': resolvedTheme.cssVars['--brand-primary'],
  'brand-accent': resolvedTheme.cssVars['--brand-accent'],
  'brand-contrast': resolvedTheme.cssVars['--brand-contrast'],
  'brand-font': resolvedTheme.cssVars['--brand-font'],
};

const currentUrl = Astro.url;
const tenantParam = currentUrl.searchParams.get('tenant');
const querySuffix = tenantParam ? `?tenant=${tenantParam}` : '';

// Plausible analytics loader is production-only: skip localhost so dev/E2E
// runs never fire dead analytics requests.
const analyticsHostname = currentUrl.hostname;
const isLocalAnalyticsHost =
  analyticsHostname === 'localhost' ||
  analyticsHostname === '127.0.0.1' ||
  analyticsHostname.endsWith('.localhost') ||
  analyticsHostname.endsWith('.127.0.0.1');

const isMarketplace = currentUrl.hostname === 'sinaicamps.com' || currentUrl.hostname === 'www.sinaicamps.com';
const marketplaceUrl = isMarketplace ? null : 'https://sinaicamps.com/';

// Content zone drives the nav deep links: on the tenant zone the Menu page is
// the tenant route `/menu`; on the marketplace zone it is the camp deep link
// `/camp/{id}/menu`.
const zone = Astro.locals.zone || 'marketplace';
const menuNavUrl = zone === 'tenant'
  ? `/menu${querySuffix}`
  : `/camp/${(tenant?.id as string) || ''}/menu${querySuffix}`;

// Accommodations deep link is zone-aware. The tenant zone lists rooms at
// /rooms; the marketplace zone lists all camps at /camps. Pointing the nav
// (and the Book Now CTA) at /rooms on the marketplace zone produced a 404.
const accommodationsHref = zone === 'tenant' ? `/rooms${querySuffix}` : `/camps${querySuffix}`;
const accommodationsLabel = zone === 'tenant' ? 'Accommodations' : 'Camps';
const accommodationsActive = (activePage === 'rooms' || activePage === 'camps') ? 'active-nav-link' : '';

const isPageActive = (path: string) => activePage === path ? 'active-nav-link' : '';

function sanitizeForHtml(str: string | undefined | null): string {
  if (!str || typeof str !== 'string') return '';
  return str.replace(/<\/?script/gi, '').replace(/"/g, '&quot;');
}

function sanitizeForJsonLd(obj: Record<string, unknown>): Record<string, unknown> {
  const clean: Record<string, unknown> = {};
  for (const [k, v] of Object.entries(obj)) {
    if (typeof v === 'string') {
      clean[k] = v.replace(/<\/script/gi, '');
    } else if (v && typeof v === 'object') {
      clean[k] = sanitizeForJsonLd(v as Record<string, unknown>);
    } else {
      clean[k] = v;
    }
  }
  return clean;
}

const metaDescription = description
  || tenant?.description
  || `Join us at ${tenantName} for an unforgettable summer experience. View accommodations and register online.`;

const ogImage = normalizeAssetUrl(tenant?.heroImageUrl) || normalizeAssetUrl(tenant?.logoUrl) || '';
const heroPreloadUrl = normalizeAssetUrl(tenant?.heroImageUrl);

const jsonLd = sanitizeForJsonLd({
  '@context': 'https://schema.org',
  '@type': 'Campground',
  name: tenantName,
  description: tenant?.description || 'Premium summer adventure camps and wilderness lodges.',
  image: ogImage,
  telephone: tenant?.phone || '',
  email: tenant?.email || '',
  address: {
    '@type': 'PostalAddress',
    addressLocality: tenant?.location || 'Sinai, Egypt',
  },
});
---
<!DOCTYPE html>
<html lang={lang} dir={dir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline>
    /* Set html.dark before first paint to match the OS color scheme (no flash).
       The theme tokens in this layout flip on html.dark; brand colors keep
       their per-tenant values in both modes. */
    (function () {
      try {
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var html = document.documentElement;
        html.classList.toggle('dark', mq.matches);
        mq.addEventListener('change', function (e) {
          html.classList.toggle('dark', e.matches);
        });
      } catch (err) {}
    })();
  </script>
  <title>{title} | {tenantName}</title>

  <meta name="description" content={sanitizeForHtml(metaDescription)} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={sanitizeForHtml(`${title} | ${tenantName}`)} />
  <meta property="og:description" content={sanitizeForHtml(metaDescription)} />
  {ogImage && <meta property="og:image" content={sanitizeForHtml(ogImage)} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={sanitizeForHtml(`${title} | ${tenantName}`)} />
  <meta name="twitter:description" content={sanitizeForHtml(metaDescription)} />
  {ogImage && <meta name="twitter:image" content={sanitizeForHtml(ogImage)} />}

  <link rel="icon" type="image/png" href={faviconUrl} />
  {heroPreloadUrl && <link rel="preload" as="image" href={heroPreloadUrl} />}
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  <!-- Pre-set React Fast Refresh preamble globals to prevent detection error on Vite 6 -->
  <script is:inline>
    window.$RefreshReg$ = function() {};
    window.$RefreshSig$ = function(type) { return type; };
    window.__vite_plugin_react_preamble_installed__ = true;
  </script>

  <style define:vars={themeVars}>
    :root {
      --primary: var(--brand-primary);
      --bg: #fdfcf9;
      --text: #2d3748;
      --text-muted: #4a5568;
      --card-bg: #ffffff;
      --border: #e2e8f0;
      --header-bg: rgba(253, 252, 249, 0.92);
    }

    /*
     * Dark-mode hook (opt-in). The theme engine ships `darkMode: 'class'`;
     * adding the `dark` class (or `data-theme="dark"`) to <html> flips the
     * surface tokens while brand colors keep their per-tenant values.
     */
    html.dark,
    html[data-theme='dark'] {
      --bg: #0f172a;
      --text: #f1f5f9;
      --text-muted: #94a3b8;
      --card-bg: #1e293b;
      --border: #334155;
      --header-bg: rgba(15, 23, 42, 0.88);
    }

    @layer base {
      * { box-sizing: border-box; margin: 0; padding: 0; }
    }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }

    .skip-link {
      position: absolute;
      top: -100%;
      left: 16px;
      z-index: 9999;
      padding: 12px 24px;
      background: var(--primary);
      color: #fff;
      font-weight: 700;
      border-radius: 0 0 8px 8px;
      text-decoration: none;
      transition: top 0.2s;
    }
    .skip-link:focus {
      top: 0;
    }

    .site-header {
      position: sticky;
      top: 0;
      background: var(--header-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      z-index: 1000;
      padding: 0 24px;
      transition: box-shadow 0.3s ease;
    }
    .site-header.scrolled {
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }
    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 64px;
    }
    .brand-link {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--text);
      font-weight: 800;
      font-size: 1.25rem;
      font-family: var(--font-display);
      transition: color 0.2s;
    }
    .brand-link:hover {
      color: var(--primary);
    }
    .brand-logo {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--primary);
    }
    /* Brand fallback mark (tent) — fills the logo slot at a balanced size */
    .brand-mark {
      width: 28px;
      height: 28px;
      flex-shrink: 0;
    }
    .site-nav {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .site-nav a {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: var(--text-muted);
      font-weight: 600;
      font-size: 0.9rem;
      transition: color 0.2s;
    }
    .site-nav a::after {
      content: '';
      position: absolute;
      inset-inline-start: 0;
      bottom: -4px;
      height: 2px;
      width: 0;
      background: var(--primary);
      transition: width 0.2s;
    }
    .site-nav a:hover::after,
    .site-nav a.active-nav-link::after {
      width: 100%;
    }
    /* Pill CTA keeps its filled look — no underline beneath the button */
    .site-nav a.cta-btn::after {
      display: none;
    }
    .site-nav a:hover,
    .site-nav a.active-nav-link {
      color: var(--primary);
    }
    .cta-btn {
      background-color: var(--primary);
      background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0));
      color: white !important;
      padding: 8px 20px;
      border-radius: 9999px;
      font-weight: 700;
      font-size: 0.9rem;
      text-decoration: none;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .cta-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 12px -1px rgba(0, 0, 0, 0.15);
    }
    .lang-toggle {
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 9999px;
      padding: 4px 12px;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      transition: color 0.2s, border-color 0.2s;
      font-family: inherit;
    }
    .lang-toggle:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    .site-footer {
      position: relative;
      overflow: hidden;
      background: linear-gradient(180deg, #16241a, #0e1a12);
      color: #a0aec0;
      padding: 60px 24px 24px;
      margin-top: 80px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    /* Soft gradient band: eases the page surface into the footer's dark brand
       block instead of a hard color edge (replaces the old chunky border). */
    .site-footer::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 96px;
      background: linear-gradient(180deg, var(--bg), rgba(22, 36, 26, 0));
      pointer-events: none;
      z-index: 0;
    }
    /* Decorative topographic texture (white, low opacity) behind footer content */
    .footer-topo {
      position: absolute;
      inset: 0;
      z-index: 0;
      color: #ffffff;
      opacity: 0.5;
      pointer-events: none;
    }
    .footer-grid,
    .footer-bottom {
      position: relative;
      z-index: 1;
    }
    .footer-grid {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 40px;
      text-align: left;
      margin-bottom: 40px;
    }
    .footer-grid h3 {
      display: flex;
      align-items: center;
      gap: 8px;
      color: white;
      font-size: 1.15rem;
      font-weight: 800;
      font-family: var(--font-display);
      margin-bottom: 14px;
    }
    .footer-grid p {
      font-size: 0.9rem;
      line-height: 1.6;
    }
    .footer-bottom {
      border-top: 1px solid #2d3748;
      padding-top: 20px;
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      font-size: 0.9rem;
    }
    .footer-bottom strong { color: white; }

    .mobile-menu-toggle {
      display: none;
      background: none;
      border: none;
      color: var(--text);
      font-size: 1.5rem;
      cursor: pointer;
      padding: 8px;
      border-radius: 8px;
      transition: background 0.2s;
    }
    .mobile-menu-toggle:hover {
      background: var(--border);
    }
    /* Menu ⇄ close glyphs swap on .open — both inline SVG, aria-hidden */
    .mobile-menu-toggle .icon-menu,
    .mobile-menu-toggle .icon-close {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .mobile-menu-toggle .icon-close {
      display: none;
    }
    .mobile-menu-toggle.open .icon-close {
      display: inline-flex;
    }
    .mobile-menu-toggle.open .icon-menu {
      display: none;
    }

    /* Scroll sentinel: drives the header shadow via IntersectionObserver
       (no scroll listener). Sits at the very top of the document. */
    .scroll-sentinel {
      position: absolute;
      top: 0;
      left: 0;
      width: 1px;
      height: 1px;
      pointer-events: none;
    }

    /* Mobile nav backdrop */
    .mobile-nav-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(4px);
      z-index: 999;
      opacity: 0;
      transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .mobile-nav-backdrop.open {
      display: block;
      opacity: 1;
    }

    @media (max-width: 768px) {
      .header-inner {
        flex-wrap: wrap;
        height: auto;
        padding: 10px 0;
      }
      .brand-link { font-size: 1.1rem; }
      .brand-logo { width: 32px; height: 32px; }
      .mobile-menu-toggle { display: flex; align-items: center; justify-content: center; }
      .site-nav {
        display: none;
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: min(320px, 85vw);
        background: var(--bg);
        flex-direction: column;
        gap: 0;
        padding: 72px 24px 32px;
        z-index: 1001;
        box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
        transform: translateX(100%);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        overflow-y: auto;
      }
      /* RTL: drawer hangs off the end (left) side. Keep this BEFORE
         .site-nav.open — equal specificity, so source order lets the
         open state (translateX(0)) win in Arabic. */
      [dir='rtl'] .site-nav {
        right: auto;
        left: 0;
        transform: translateX(-100%);
        box-shadow: 4px 0 24px rgba(0, 0, 0, 0.15);
      }
      .site-nav.open {
        display: flex;
        transform: translateX(0);
      }
      .site-nav a {
        padding: 14px 0;
        font-size: 1rem;
        border-bottom: 1px solid var(--border);
        width: 100%;
      }
      .site-nav a:last-of-type { border-bottom: none; }
      .lang-toggle {
        margin-top: 8px;
        width: 100%;
        text-align: center;
        padding: 12px;
      }
      .cta-btn {
        margin-top: 8px;
        width: 100%;
        text-align: center;
        padding: 14px 20px;
      }
    }

    /* Reduced motion: snap the drawer/backdrop instead of sliding, and drop
       the header's shadow crossfade and CTA lift. */
    @media (prefers-reduced-motion: reduce) {
      .site-nav,
      .mobile-nav-backdrop,
      .site-header {
        transition: none !important;
      }
      .cta-btn,
      .cta-btn:hover {
        transform: none !important;
      }
    }
  </style>

  <!-- Plausible analytics loader (production-only, skipped on localhost so
       dev/E2E never fire dead analytics requests). data-domain resolves the
       request hostname to the matching Plausible site. -->
  {!isLocalAnalyticsHost && (
    <script defer data-domain={resolveDataDomain(analyticsHostname)} src="https://plausible.io/js/script.tagged-events.js"></script>
  )}
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>

  <header class="site-header" id="siteHeader" role="banner">
    <div class="header-inner">
      <a href={`/${querySuffix}`} class="brand-link">
        {normalizeAssetUrl(tenant?.logoUrl) ? (
          <img src={normalizeAssetUrl(tenant?.logoUrl)} class="brand-logo" alt="" />
        ) : (
          <svg
            class="brand-mark"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 20 12 4l9 16" />
            <path d="M3 20h18" />
            <path d="m9.2 20 2.8-7 2.8 7" />
          </svg>
        )}
        <span>{tenantName}</span>
      </a>

      <button
        class="mobile-menu-toggle"
        aria-label="Toggle navigation"
        aria-expanded="false"
        id="mobileMenuToggle"
      >
        <span class="icon-menu">
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 7h16" />
            <path d="M4 12h16" />
            <path d="M4 17h16" />
          </svg>
        </span>
        <span class="icon-close">
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </span>
      </button>

      <nav class="site-nav" id="siteNav" data-testid="site-nav" aria-label="Main navigation">
        {marketplaceUrl && (
          <a href={marketplaceUrl}>
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 10 4.6 4h14.8L21 10" />
              <path d="M4 10v10h16V10" />
              <path d="M10 20v-5h4v5" />
            </svg>
            Marketplace
          </a>
        )}
        <a href={`/${querySuffix}`} class={isPageActive('home')}>Home</a>
        <a href={accommodationsHref} class={accommodationsActive}>{accommodationsLabel}</a>
        <a href={`/about${querySuffix}`} class={isPageActive('about')}>About</a>
        {tenant?.menuConfig && (
          <a href={menuNavUrl} class={isPageActive('menu')}>
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 2v7a2 2 0 0 0 4 0V2" />
              <path d="M5 2v20" />
              <path d="M15 2v7a3 3 0 0 0 6 0V2" />
              <path d="M18 2v20" />
            </svg>
            Menu
          </a>
        )}
        <a href={`/gallery${querySuffix}`} class={isPageActive('gallery')}>Gallery</a>
        <a href={`/faq${querySuffix}`} class={isPageActive('faq')}>FAQ</a>
        <a href={`/contact${querySuffix}`} class={isPageActive('contact')}>Contact</a>
        <button id="langToggle" data-testid="lang-toggle" class="lang-toggle" aria-label="Switch language">عربي</button>
        <a href={accommodationsHref} class={`cta-btn ${accommodationsActive}`}>Book Now</a>
      </nav>
    </div>
  </header>
  <div id="scrollSentinel" class="scroll-sentinel" aria-hidden="true"></div>
  <div class="mobile-nav-backdrop" id="mobileNavBackdrop"></div>

  <main id="main-content" role="main">
    <slot />
  </main>

  <footer class="site-footer" data-testid="site-footer" role="contentinfo">
    <div class="footer-topo" aria-hidden="true"></div>
    <div class="footer-grid">
      <div>
        <h3>
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 20 12 4l9 16" />
            <path d="M3 20h18" />
            <path d="m9.2 20 2.8-7 2.8 7" />
          </svg>
          {tenantName}
        </h3>
        <p>{tenant?.description || 'Experience premium summer camp programs and wilderness lodges.'}</p>
      </div>
      <div>
        <h3>
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          Location
        </h3>
        <p>{tenant?.location || 'Sinai, Egypt'}</p>
      </div>
      <div data-testid="footer-contact">
        <h3>
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          Contact Us
        </h3>
        <p style="margin-bottom: 8px;"><strong>Phone:</strong> {tenant?.phone || 'N/A'}</p>
        <p style="margin-bottom: 8px;"><strong>WhatsApp:</strong> {tenant?.whatsappNumber || 'N/A'}</p>
        <p><strong>Email:</strong> {tenant?.email || 'N/A'}</p>
      </div>
    </div>
    <div class="footer-bottom" data-testid="footer-bottom">
      <p data-testid="footer-copyright">{tenant?.footerText || `© ${new Date().getFullYear()} ${tenantName}. All rights reserved.`}</p>
      <p>Powered by <strong>CampMaster Pro</strong></p>
    </div>
  </footer>
  <script is:inline>
    /* ── Lang toggle ── */
    (function() {
      function setLangCookie(val) {
        document.cookie = 'sc_lang=' + val + '; path=/; max-age=31536000; SameSite=Lax';
      }

      var urlParams = new URLSearchParams(window.location.search);
      var paramLang = urlParams.get('lang');
      var stored = paramLang || localStorage.getItem('sc_lang') || 'en';
      if (paramLang && paramLang !== localStorage.getItem('sc_lang')) {
        localStorage.setItem('sc_lang', paramLang);
      }
      /* Sync cookie so SSR can detect the language on subsequent requests */
      if (localStorage.getItem('sc_lang')) {
        setLangCookie(localStorage.getItem('sc_lang'));
      }
      document.documentElement.lang = stored;
      document.documentElement.dir = stored === 'ar' ? 'rtl' : 'ltr';
      var btn = document.getElementById('langToggle');
      if (!btn) return;
      btn.textContent = stored === 'en' ? 'عربي' : 'EN';
      btn.setAttribute('aria-label', stored === 'en' ? 'Switch to Arabic' : 'Switch to English');
      btn.addEventListener('click', function() {
        var next = localStorage.getItem('sc_lang') === 'ar' ? 'en' : 'ar';
        localStorage.setItem('sc_lang', next);
        setLangCookie(next);
        document.documentElement.lang = next;
        document.documentElement.dir = next === 'ar' ? 'rtl' : 'ltr';
        btn.textContent = next === 'en' ? 'عربي' : 'EN';
        btn.setAttribute('aria-label', next === 'en' ? 'Switch to Arabic' : 'Switch to English');
        window.location.reload();
      });
    })();

    /* ── Header shadow on scroll ──
       An IntersectionObserver on a top-of-page sentinel replaces the scroll
       listener: the header gains .scrolled once the sentinel leaves the
       viewport's top 10px and loses it again when the page returns to top. */
    (function () {
      var header = document.getElementById('siteHeader');
      var sentinel = document.getElementById('scrollSentinel');
      if (!header || !sentinel || !('IntersectionObserver' in window)) return;
      var observer = new IntersectionObserver(function (entries) {
        header.classList.toggle('scrolled', !entries[0].isIntersecting);
      }, { rootMargin: '-10px 0px 0px 0px', threshold: 0 });
      observer.observe(sentinel);
    })();

    /* ── Mobile nav drawer ── */
    (function () {
      var toggle = document.getElementById('mobileMenuToggle');
      var nav = document.getElementById('siteNav');
      var backdrop = document.getElementById('mobileNavBackdrop');
      if (!toggle || !nav || !backdrop) return;

      function openMenu() {
        nav.classList.add('open');
        backdrop.classList.add('open');
        toggle.classList.add('open');
        toggle.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }
      function closeMenu() {
        nav.classList.remove('open');
        backdrop.classList.remove('open');
        toggle.classList.remove('open');
        toggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      toggle.addEventListener('click', function () {
        if (nav.classList.contains('open')) closeMenu(); else openMenu();
      });
      backdrop.addEventListener('click', closeMenu);
      nav.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', closeMenu);
      });
      window.addEventListener('resize', function () {
        if (window.innerWidth > 768) closeMenu();
      });
    })();
  </script>
</body>
</html>
