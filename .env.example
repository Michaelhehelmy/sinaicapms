# ══════════════════════════════════════════════════════════════════════
# SinaiCamps Environment Variables
# Copy this file to .env and fill in the values for your environment.
# ══════════════════════════════════════════════════════════════════════

# ── Backend (Cloudflare Worker) ──────────────────────────────────────
# JWT secret for admin + POS token signing (REQUIRED — no fallback)
JWT_SECRET=your-secret-key-here

# Stripe integration — (not implemented — payments path is a 501 stub; the
# Stripe-webhook retirement in payments.js means no runtime code reads these
# vars. STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_PUBLISHABLE_KEY are
# documented for historical purposes only; see backend/src/api/payments.js:13)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Rate limiting (KV-based)
RATE_LIMIT_KV_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Environment identifier (production | staging | development)
ENVIRONMENT=development

# ── Frontend (Astro/React) ──────────────────────────────────────────
# Public Stripe key (for client-side Stripe.js) — (not implemented — see
# Stripe note above; no frontend Stripe.js integration exists)
PUBLIC_STRIPE_KEY=

# API base URL (leave empty for same-origin, set for local dev)
PUBLIC_API_URL=http://localhost:8787

# ── Cloudflare Bindings (configured in wrangler.toml, not here) ──────
# DB        — D1 database binding
# KV_CACHE  — KV namespace for rate limiting
# MEDIA_BUCKET — R2 bucket for uploaded images
# BROADCASTER — Durable Object for SSE live stream

# ── Development ──────────────────────────────────────────────────────
# Node.js environment
NODE_ENV=development

# Astro dev server port
PORT=4320

# ── Deployment ───────────────────────────────────────────────────────
# Cloudflare account ID (for wrangler CLI)
# CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API token (for wrangler CLI — prefer `wrangler login` over this)
# CLOUDFLARE_API_TOKEN=

# ── Email (optional — for transactional emails) ──────────────────────
# RESEND_API_KEY=
# EMAIL_FROM=noreply@sinaicamps.com
